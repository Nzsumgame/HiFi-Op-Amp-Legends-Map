      "source": "Datasheet Rev. L Tables 1–3, Fig. 20"
    },
    {
      "parameter": "Supply range",
      "value": "5–24 V total (±2.5 to ±12 V); 26.4 V absolute max",
      "condition": "AD8065W over temperature: 5–10 V",
      "source": "Datasheet Rev. L Tables 1–4; Rev. D"
    },
    {
      "parameter": "Supply current",
      "value": "6.4 mA typ / 7.2 mA max per amp (±5 V)",
      "condition": "25 °C; ±12 V: 6.6 / 7.4 mA",
      "source": "Datasheet Rev. L Tables 1–3"
    },
    {
      "parameter": "Output current",
      "value": "35 mA (±5 V), 30 mA (±12 V); short circuit 90/120 mA",
