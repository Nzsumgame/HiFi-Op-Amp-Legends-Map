  "reputation": {
    "summary": "Measured noise and distortion are exceptional, and measurement-minded users treat it as transparent. audioXpress found it beat NE5532 with shunt feedback and as a follower, equal with series feedback. Soomal tracks it in Chinese phones and DAPs from 2014 and, by 2022, in most I/V stages. Subjective views split: 'reference sound' in Japan, 'hard, not pleasing' (偏硬) at Soomal.",
    "sonic_descriptors": [
      "neutral 'reference sound'",
      "transparent",
      "flat, genre-neutral",
      "musical, delicate, warm (OPA1611)",
      "hard (偏硬), not pleasing",
      "better dynamics than NE5534",
      "worse than DiFET types"
    ],
    "typical_uses": [
      "DAC I/V conversion (Sabaj A20d, Topping DX7 Pro)",
      "Output LPF or post-I/V buffer in DAPs and Hi-Fi phones",
      "Input stage of composite headphone amps with TPA6120 / THS6012",
      "Pro audio, mic preamps, consoles, broadcast, test gear",
      "Op-amp rolling via DIP-8 adapter boards (NFJ, AliExpress)"
    ],
    "caveats": [
      "High current noise (1.7 pA/√Hz) loses its edge with 10 kΩ+ source or feedback networks.",
      "Input range stops 2 V from each rail; clamp diodes conduct on fast edges, limit input to 10 mA.",
      "Capacitive loads at low gain can oscillate; use ~50 Ω isolation and careful adapter layout.",
      "3.6 mA/ch with 150 °C/W SOIC-8: solder rather than socket. NFJ 'new lot' reportedly means boards, not silicon.",
      "Subjective descriptors conflict; Soomal 2016 mislabels it 'Bipolar FET'. No controlled listening test."
    ],
