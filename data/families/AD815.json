  "reputation": {
    "summary": "A niche DIY favourite, not a mainstream audio op-amp. Reports come from Head-Fi (including a portable OPA132 + AD815 design), s3t.it's 'The Buffa', a pinkfishmedia preamp build thread and a Linear Audio power-amp article. Users report great headphone sound, deep punchy bass, nice mids and smooth detailed treble. Forums cite TI's THS6012 as near-equivalent, some say slightly cleaner treble.",
    "sonic_descriptors": [
      "deep, punchy bass",
      "well-controlled bass",
      "really nice mids",
      "detailed but smooth treble"
    ],
    "typical_uses": [
      "DIY headphone amp output stage (Head-Fi, 'The Buffa')",
      "Line preamp / buffer (pinkfishmedia build)",
      "Small power amplifier (Linear Audio article)",
      "Designed for xDSL/HDSL lines, video, coil/transformer drive"
    ],
    "caveats": [
      "Obsolete; SIP/DDPAK versions DIY builds used were deleted at Rev. D, so parts are scarce.",
      "Forums report DC offset up to about 50 mV; datasheet offset specs not checked.",
      "Current feedback: needs the specified feedback resistor (RFB = 1 kΩ); not a voltage-feedback drop-in.",
      "Power package needs heat-sinking at high output currents.",
      "Impressions are subjective forum reports."
    ],
    "sources": [
      "https://www.head-fi.org/threads/ad815.181226/",
      "https://pinkfishmedia.net/forum/threads/ad815-preamp-build-thread.46481/page-5",
      "https://linearaudio.net/ad815-power-amp",
      "https://s3t.it/headphone-amplifiers/ad815-the-buffa/",
      "https://www.head-fi.org/threads/new-portable-headphone-amplifier-opa132-ad815-development.492155/"
    ]
  },
  "counterfeit_notes": "No specific counterfeit reports. Obsolete and scarce; the SIP/DDPAK versions DIY builds want were deleted years ago, so stock comes from brokers and surplus. Distrust re-marked or cheap parts; check package and markings against the datasheet.",
  "alternatives": [
    "TI THS6012 (500 mA dual line driver)",
    "ADI AD816 (sibling driver, also obsolete)",
    "ADI AD8016 (xDSL driver, unverified for audio)"
  ],
