  "reputation": {
    "summary": "Known from portable OEM gear and Head-Fi rolling, not classic hi-fi. FiiO used it as the E10K headphone buffer (replacing the AD8397); iBasso used it stock. Users call it warm and relaxed, 'hard to beat for buffers' into low impedances; others say it lacks some impact. All subjective forum impressions.",
    "sonic_descriptors": [
      "warm",
      "relaxed",
      "intimate upper-register detail",
      "clean, open (with ADA4841-2)",
      "slightly less impact"
    ],
    "typical_uses": [
      "Headphone buffer in FiiO E10K, X3-II, X5, E18; iBasso D-series",
      "Virtual-ground (rail-splitter) op-amp in portable amps",
      "Buffer after DAC I/V or gain stage at low supplies"
    ],
    "caveats": [
      "12.8 V maximum supply (about ±6.4 V): never roll into ±15 V sockets.",
      "17 nV/√Hz is noisy versus NE5532 or LME49720; suits buffers, not low-level gain stages.",
      "130 MHz part: layout and decoupling matter; capacitive loads may need an isolation resistor.",
      "Some iBasso units reportedly shipped with THS4032 instead; FiiO X3-II/X5/E18 use is forum-reported.",
      "Users preferring LME49721 or OPA2727 report less 'impact and boldness' as a buffer."
    ],
    "sources": [
      "https://www.head-fi.org/threads/the-fiio-e10k-all-new-dac-and-amp-stages.726304/page-2",
      "https://www.fiio.com/e10k",
      "https://www.head-fi.org/showcase/fiio-x3-2nd-gen-ultraportable-hi-res-dap.20614/reviews?order=rating&direction=asc&page=2",
      "https://www.head-fi.org/threads/lme49721-torn-discussion.429045/",
      "https://www.head-fi.org/threads/new-portable-amp-dac-ibasso-d1-with-updates-on-the-first-page.251541/",
      "https://www.head-fi.org/threads/new-portable-amp-dac-ibasso-d1-with-updates-on-the-first-page.251541/page-131",
      "https://www.diyaudio.com/community/threads/lmh6643-amplifier.224504/",
      "https://www.ti.com/product/LMH6643"
    ]
  },
  "counterfeit_notes": "No LMH664x-specific counterfeit or remarking reports. Parts are cheap and widely stocked. Leaded non-NOPB codes (e.g. LMH6642MF) are older NRND production with a different lead finish, not fakes. Treat marketplace SOIC/VSSOP parts with usual caution.",
  "alternatives": [
    "AD8397",
    "THS4032",
    "LME49721",
    "OPA2727",
    "ADA4841-2 (L/R partner in iBasso rolling)"
  ],
