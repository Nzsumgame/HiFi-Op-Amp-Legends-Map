  "reputation": {
    "summary": "A precision DC part, not an audio design, with a small following among Japanese op-amp rollers. A zigsow review ('低電力でクリアな音質', 'Low power, clear sound') praises the OPA2277P, and Silicon House blogged 'Surprise! It's the OPA2277!'. Users call it clear and balanced; versus the OPA2134 slightly veiled, versus the OPA2604 more vocal-forward. Some find it forward or harsh.",
    "sonic_descriptors": [
      "clear",
      "balanced",
      "vocal-forward",
      "slightly veiled (vs OPA2134)",
      "strong bass",
      "forward, sometimes harsh"
    ],
    "typical_uses": [
      "DIP-8 rolling in DACs, headphone and portable amps",
      "precision DC and instrumentation stages"
    ],
    "caveats": [
      "1 MHz GBW and 0.8 V/µs slew are modest for audio stages.",
      "Praise comes from a few Japanese hobbyist sources, not measurements.",
      "DIP-8 PA grades are NRND, so rolling stock may be old or marketplace-sourced.",
      "Voltage noise density not confirmed (commonly quoted ~8 nV/√Hz)."
    ],
    "sources": [
      "https://zigsow.jp/item/298614/review/321038",
      "http://blog.siliconhouse.jp/archives/51995262.html"
    ]
  },
  "counterfeit_notes": "No OPAx277-specific counterfeit reports. DIP-8 OPA2277P/PA units are widely sold by marketplace sellers and PA is NRND. Buy from authorized distributors; check TI/BB marking and offset against the datasheet.",
  "alternatives": [
    "OPA2134",
    "OPA2604",
    "OPA2205 (newer e-trim precision bipolar)",
    "OP07 / OP177 (classic predecessors)"
  ],
